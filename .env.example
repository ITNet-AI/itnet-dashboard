NEXT_PUBLIC_SUPABASE_URL=https://pytuwcbtylectoipbjfw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Supabase dashboard > Project settings > API keys > Secret keys.
SUPABASE_SECRET_KEY=
# Where invite and reset links send people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Invite and password-reset emails. Sent from info@itnetai.com, so itnetai.com must be verified in Resend.
RESEND_API_KEY=

# Agent tab. Required for the chat to work.
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace: the workspace id from console.anthropic.com.
ANTHROPIC_WORKSPACE_ID=
# Optional. Defaults to claude-sonnet-5-5.
AGENT_MODEL=
# Claude connector (optional). Pin which OAuth clients may connect, comma-separated.
MCP_OAUTH_CLIENT_IDS=
# Set to 1 to switch the Claude connector off.
MCP_DISABLED=
